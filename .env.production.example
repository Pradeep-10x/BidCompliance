# Copy this file to .env on the EC2 host. Never commit the real .env file.
COMPOSE_PROJECT_NAME=pramaan
PROJECT_NAME=PRAMAAN
ENVIRONMENT=production

# Generate both secrets independently, for example: openssl rand -hex 32
POSTGRES_USER=pramaan
POSTGRES_PASSWORD=replace_with_a_long_random_database_password
POSTGRES_DB=pramaan
# Keep these service names for the included Compose database and queue.
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
SECRET_KEY=replace_with_a_different_64_character_random_secret

# Accepted public hostnames. Do not include https:// here.
TRUSTED_HOSTS=pramaan.example.com,www.pramaan.example.com,localhost,127.0.0.1
# Exact browser origins allowed to call the API. Do not add a trailing slash.
CORS_ORIGINS=https://pramaan.example.com,https://your-project.vercel.app

# The included Nginx frontend calls /api/v1 on the same origin.
VITE_API_BASE_URL=/api/v1
# Keep true until the dashboard contracts are connected to the real API.
VITE_USE_MOCK=true

# Only the frontend is public. Internal service ports bind to EC2 loopback.
HTTP_PORT=80
BIND_ADDRESS=127.0.0.1
POSTGRES_PORT_HOST=5432
REDIS_PORT_HOST=6379
BACKEND_PORT_HOST=8000
ML_PORT_HOST=8001

ACCESS_TOKEN_EXPIRE_MINUTES=60
MAX_UPLOAD_SIZE_BYTES=26214400
MAX_UPLOAD_SIZE_MB=25
PROCESSING_JOB_MAX_ATTEMPTS=3
ML1_CONNECT_TIMEOUT_SECONDS=5
ML1_READ_TIMEOUT_SECONDS=120
ML1_TOTAL_TIMEOUT_SECONDS=125
ML1_BASE_URL=http://ml-services:8001
ML_SERVICE_URL=http://ml-services:8001
ML_REQUEST_TIMEOUT_SECONDS=120
CELERY_CONCURRENCY=2
CELERY_LOG_LEVEL=INFO

# Application Settings
PROJECT_NAME="PRAMAAN"
ENVIRONMENT="development"

# Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=sih_project

# Security & JWT Configuration
SECRET_KEY=change_this_to_a_secure_secret_key_min_32_chars_long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUSTED_HOSTS=localhost,127.0.0.1

# Document storage
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=storage
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=documents
STORAGE_SECURE=false
MAX_UPLOAD_SIZE_BYTES=10485760

# Processing job queue
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
PROCESSING_JOB_MAX_ATTEMPTS=3

# ML-1 integration
ML1_BASE_URL=http://localhost:8001
ML1_CONNECT_TIMEOUT_SECONDS=5
ML1_READ_TIMEOUT_SECONDS=30
ML1_TOTAL_TIMEOUT_SECONDS=35

# Synchronous SIH demo compatibility
STORAGE_ROOT=./storage
MAX_UPLOAD_SIZE_MB=25
ML_SERVICE_URL=http://localhost:8001
ML_REQUEST_TIMEOUT_SECONDS=120

# Install as /etc/pramaan/backend.env with mode 600.
PROJECT_NAME=PRAMAAN
ENVIRONMENT=production

POSTGRES_SERVER=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=pramaan
POSTGRES_PASSWORD=replace_with_a_url_safe_random_password
POSTGRES_DB=pramaan

SECRET_KEY=replace_with_a_different_random_secret_of_at_least_32_characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

TRUSTED_HOSTS=pramaan.example.com,localhost,127.0.0.1
CORS_ORIGINS=https://pramaan.example.com

STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=/var/lib/pramaan/documents
STORAGE_ROOT=/var/lib/pramaan/documents
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=documents
STORAGE_REGION=ap-south-1
STORAGE_SERVER_SIDE_ENCRYPTION=AES256
STORAGE_SECURE=false
MAX_UPLOAD_SIZE_BYTES=26214400
MAX_UPLOAD_SIZE_MB=25

CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
PROCESSING_QUEUE_ENABLED=true
PROCESSING_JOB_MAX_ATTEMPTS=3

ML_DOCUMENT_ROOT=/var/lib/pramaan/documents
ML1_BASE_URL=http://127.0.0.1:8001
ML1_CONNECT_TIMEOUT_SECONDS=5
ML1_READ_TIMEOUT_SECONDS=120
ML1_TOTAL_TIMEOUT_SECONDS=125
ML_SERVICE_URL=http://127.0.0.1:8001
ML_REQUEST_TIMEOUT_SECONDS=120
ML_SHARED_SECRET=

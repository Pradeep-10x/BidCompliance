[Unit]
Description=PRAMAAN ML document intelligence service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pramaan
Group=pramaan
WorkingDirectory=/opt/pramaan/ml-services
EnvironmentFile=/etc/pramaan/backend.env
ExecStart=/opt/pramaan/ml-services/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8001
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target

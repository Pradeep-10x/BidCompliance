# Render FastAPI web service. Add these as secret environment variables.
ENVIRONMENT=production
PROJECT_NAME=PRAMAAN

# Copy the separate internal connection values from Render Postgres.
POSTGRES_SERVER=replace-with-render-internal-host
POSTGRES_PORT=5432
POSTGRES_USER=replace-with-render-user
POSTGRES_PASSWORD=replace-with-render-password
POSTGRES_DB=replace-with-render-database

SECRET_KEY=replace-with-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
TRUSTED_HOSTS=replace-with-api-service.onrender.com
CORS_ORIGINS=https://replace-with-project.vercel.app

# Private AWS S3 bucket. The IAM key must be restricted to this bucket.
STORAGE_BACKEND=s3
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=replace-with-restricted-iam-access-key
STORAGE_SECRET_KEY=replace-with-restricted-iam-secret
STORAGE_BUCKET=replace-with-private-s3-bucket
STORAGE_REGION=ap-south-1
STORAGE_SERVER_SIDE_ENCRYPTION=AES256
STORAGE_SECURE=true
MAX_UPLOAD_SIZE_BYTES=26214400
MAX_UPLOAD_SIZE_MB=25
PROCESSING_QUEUE_ENABLED=false

# Public Render ML web service, protected with the shared secret below.
ML1_BASE_URL=https://replace-with-ml-service.onrender.com
ML1_CONNECT_TIMEOUT_SECONDS=10
ML1_READ_TIMEOUT_SECONDS=180
ML1_TOTAL_TIMEOUT_SECONDS=190
ML_SERVICE_URL=https://replace-with-ml-service.onrender.com
ML_REQUEST_TIMEOUT_SECONDS=180
ML_SHARED_SECRET=replace-with-a-separate-openssl-rand-hex-32

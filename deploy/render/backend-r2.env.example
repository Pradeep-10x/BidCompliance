# Render FastAPI web service with Cloudflare R2 object storage.
ENVIRONMENT=production
PROJECT_NAME=PRAMAAN

# Use Render's INTERNAL database values when API and Postgres share a region.
POSTGRES_SERVER=replace-with-render-internal-host
POSTGRES_PORT=5432
POSTGRES_USER=replace-with-render-user
POSTGRES_PASSWORD=replace-with-rotated-render-password
POSTGRES_DB=replace-with-render-database

SECRET_KEY=replace-with-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
TRUSTED_HOSTS=replace-with-api-service.onrender.com
CORS_ORIGINS=https://replace-with-project.vercel.app

# Cloudflare R2 S3-compatible credentials. Restrict the token to one bucket.
STORAGE_BACKEND=s3
STORAGE_ENDPOINT=https://replace-with-cloudflare-account-id.r2.cloudflarestorage.com
STORAGE_ACCESS_KEY=replace-with-r2-access-key-id
STORAGE_SECRET_KEY=replace-with-r2-secret-access-key
STORAGE_BUCKET=replace-with-r2-bucket-name
STORAGE_REGION=auto
# R2 encrypts objects automatically and rejects the AWS SSE upload header.
STORAGE_SERVER_SIDE_ENCRYPTION=none
STORAGE_SECURE=true
MAX_UPLOAD_SIZE_BYTES=26214400
MAX_UPLOAD_SIZE_MB=25
PROCESSING_QUEUE_ENABLED=false

ML1_BASE_URL=https://replace-with-ml-service.onrender.com
ML1_CONNECT_TIMEOUT_SECONDS=10
ML1_READ_TIMEOUT_SECONDS=180
ML1_TOTAL_TIMEOUT_SECONDS=190
ML_SERVICE_URL=https://replace-with-ml-service.onrender.com
ML_REQUEST_TIMEOUT_SECONDS=180
ML_SHARED_SECRET=replace-with-a-separate-openssl-rand-hex-32
